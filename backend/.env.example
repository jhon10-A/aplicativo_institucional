# Copy to backend/.env only if it does not exist. Fill values privately.
# Empty entries are ignored, preserving application-local.properties.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET_BASE64=

# Optional overrides; omit or leave empty to retain current defaults.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/db_institucional
# APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
# APP_JWT_TTL_SECONDS=3600
# SERVER_PORT=8080
